# Copie para .env e troque as senhas fora do ambiente acadêmico local.
POSTGRES_DB=biblioteca
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=troque_esta_senha_postgres

RABBITMQ_USER=biblioteca
RABBITMQ_PASSWORD=troque_esta_senha_rabbitmq

# Portas publicadas somente no host. Entre containers são usados os nomes dos
# serviços e as portas internas 5432, 5672 e 9999.
GATEWAY_PORT=9999
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Parâmetros da aplicação.
WORKER_PREFETCH=1
WORKER_MAX_RETRIES=3

# Failpoints são exclusivos de demonstração/teste. Mantenha 0 normalmente.
ENABLE_FAILPOINTS=0
FAILPOINT=
FAILPOINT_REQUEST_ID=

